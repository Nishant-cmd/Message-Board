<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Message Board</title>
    <link rel="stylesheet" href="/style.css" />
</head>

<body>

    <nav class="navbar">
        <div class="navbar__inner">
            <a href="/" class="navbar__brand">Message Board</a>
        </div>
    </nav>

    <main class="page-wrapper">

        <header class="page-header">
            <p class="page-header__eyebrow">A place to share</p>
            <h1 class="page-header__title">Message Board</h1>
            <p class="page-header__subtitle">Small thoughts, shared openly.</p>
        </header>

        <div class="section-actions">
            <form method="GET" action="/new">
                <button class="btn btn--primary" type="submit">+ Write a Message</button>
            </form>
        </div>

        <div class="messages-list">
            <% if (users.length===0) { %>
                <div class="empty-state">No messages yet. Be the first to share something.</div>
                <% } %>

                    <% users.map((user, index)=> { %>
                        <div class="message-card">
                            <div class="message-card__meta">
                                <span class="message-card__author">
                                    <%= user.username %>
                                </span>
                                <span class="message-card__date">
                                    <%= user.created_at %>
                                </span>
                            </div>
                            <p class="message-card__text">
                                <%= user.messagetext %>
                            </p>
                            <div class="message-card__footer">
                                <form method="GET" action="/message/<%= index + 1 %>">
                                    <button class="btn btn--outline btn--sm" type="submit">Read →</button>
                                </form>
                            </div>
                        </div>
                        <% }) %>
        </div>

    </main>

    <footer class="site-footer">
        &copy; Message Board
    </footer>

</body>

</html>
