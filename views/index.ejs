<html>
<head>
<title>Message Board</title>
</head>
<body>
    <div>
        <p> A PLACE TO SHARE</p>
        <h1>Message Board</h1>
        <p>Small thoughts,shared openly</p>
        <form method="GET" action="/new"    >
             <button>Write a new Message</button>
        </form>  
    </div>
<div>
<% messages.map((message,index)=>{ %>
<div>
    <p><%=message.user %></p>
    <p> <%=message.added %></p>
</div>
<p> <%=message.text %></p>

   <form  method="GET" action="/message/<%=index %>"    >
             <button>Open</button>
        </form>  
<% }) %>
</div>
</body>
</html>
