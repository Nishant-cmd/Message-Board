<html>
  <head>
    <title>Message Info</title>
  </head>
  <body>
    <div>
      <h3>Message Details</h3>
      <p><%=message.user %> created a post</p>
      <p><%=message.text %></p>
      <p>Created: <%=message.added %></p>
      <form method="GET" action="/">
        <button type="submit">Back to messages</button>
      </form>
    </div>
  </body>
</html>
